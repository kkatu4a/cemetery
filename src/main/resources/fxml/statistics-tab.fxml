<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.katu4a.cladbise.controller.StatisticsTabController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Статистика кладбища и заявок" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button text="Обновить показатели" onAction="#loadStatistics"/>
    </HBox>

    <!-- 6 карточек показателей -->
    <FlowPane hgap="15" vgap="15">
        <VBox alignment="CENTER" prefWidth="170" styleClass="metric-card">
            <Label text="Всего заявок" styleClass="metric-title"/>
            <Label fx:id="lblTotalRequests" text="0" styleClass="metric-value, metric-blue"/>
        </VBox>

        <VBox alignment="CENTER" prefWidth="170" styleClass="metric-card">
            <Label text="Новые заявки" styleClass="metric-title"/>
            <Label fx:id="lblNewRequests" text="0" styleClass="metric-value, metric-amber"/>
        </VBox>

        <VBox alignment="CENTER" prefWidth="170" styleClass="metric-card">
            <Label text="Выполнено заявок" styleClass="metric-title"/>
            <Label fx:id="lblCompletedRequests" text="0" styleClass="metric-value, metric-green"/>
        </VBox>

        <VBox alignment="CENTER" prefWidth="190" styleClass="metric-card">
            <Label text="Общая выручка" styleClass="metric-title"/>
            <Label fx:id="lblTotalRevenue" text="0 ₽" styleClass="metric-value, metric-purple"/>
        </VBox>

        <VBox alignment="CENTER" prefWidth="170" styleClass="metric-card">
            <Label text="Всего мест" styleClass="metric-title"/>
            <Label fx:id="lblTotalPlots" text="0" styleClass="metric-value, metric-cyan"/>
        </VBox>

        <VBox alignment="CENTER" prefWidth="170" styleClass="metric-card">
            <Label text="Свободных мест" styleClass="metric-title"/>
            <Label fx:id="lblFreePlots" text="0" styleClass="metric-value, metric-teal"/>
        </VBox>
    </FlowPane>

    <!-- 2 круговые диаграммы: по заявкам и по местам -->
    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <PieChart fx:id="pieChartRequests" title="Заявки по статусам" HBox.hgrow="ALWAYS"/>
        <PieChart fx:id="pieChartPlots" title="Места по статусам" HBox.hgrow="ALWAYS"/>
    </HBox>
</VBox>