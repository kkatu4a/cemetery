<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.katu4a.cladbise.controller.PlotsTabController"
      styleClass="tab-content">

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="Добавить" styleClass="primary-button" onAction="#onAdd"/>
        <Button fx:id="editButton" text="Изменить" onAction="#onEdit"/>
        <Button fx:id="deleteButton" text="Удалить" styleClass="danger-button" onAction="#onDelete"/>
        <Button text="Обновить" onAction="#onRefresh"/>
    </HBox>

    <TableView fx:id="plotsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="sectorColumn" text="Сектор" prefWidth="150"/>
            <TableColumn fx:id="rowColumn" text="Ряд" prefWidth="70"/>
            <TableColumn fx:id="plotNumberColumn" text="Место" prefWidth="80"/>
            <TableColumn fx:id="statusColumn" text="Статус" prefWidth="150"/>
            <TableColumn fx:id="lengthColumn" text="Длина, см" prefWidth="100"/>
            <TableColumn fx:id="widthColumn" text="Ширина, см" prefWidth="100"/>
            <TableColumn fx:id="coordinatesColumn" text="Координаты" prefWidth="200"/>
        </columns>
    </TableView>

    <Label fx:id="statusLabel"/>
</VBox>