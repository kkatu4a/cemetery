<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.katu4a.cladbise.controller.CustomerFormController"
      styleClass="form"
      prefWidth="460">

    <Label fx:id="titleLabel" styleClass="form-title"/>

    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="120" prefWidth="140"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="ФИО" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="fullNameField" promptText="Фамилия Имя Отчество"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Телефон" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="phoneField" promptText="+7XXXXXXXXXX"
                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Email" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="emailField" promptText="Необязательно"
                   GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>

    <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" maxWidth="Infinity"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Сохранить" styleClass="primary-button" defaultButton="true"
                onAction="#onSave"/>
        <Button text="Отмена" cancelButton="true" onAction="#onCancel"/>
    </HBox>
</VBox>
