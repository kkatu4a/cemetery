<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.katu4a.cladbise.controller.EmployeesTabController"
      styleClass="tab-content">

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="Добавить" styleClass="primary-button" onAction="#onAdd"/>
        <Button fx:id="editButton" text="Изменить" onAction="#onEdit"/>
        <Button fx:id="deleteButton" text="В архив" styleClass="danger-button" onAction="#onDelete"/>
        <Button text="Обновить" onAction="#onRefresh"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Поиск: ФИО, логин" prefWidth="320"/>
        <Button text="Сбросить" onAction="#onReset"/>
    </HBox>

    <TableView fx:id="employeesTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="fullNameColumn" text="ФИО" prefWidth="300"/>
            <TableColumn fx:id="roleColumn" text="Роль" prefWidth="110"/>
            <TableColumn fx:id="loginColumn" text="Логин" prefWidth="160"/>
            <TableColumn fx:id="activeColumn" text="Активен" prefWidth="90"/>
            <TableColumn fx:id="createdColumn" text="Дата создания" prefWidth="150"/>
        </columns>
    </TableView>

    <Label fx:id="statusLabel"/>
</VBox>