<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" prefWidth="500" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.katu4a.cladbise.controller.RequestDialogController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <GridPane hgap="12" vgap="12">
        <columnConstraints>
            <ColumnConstraints minWidth="140" prefWidth="150"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Заявитель *:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbCustomer" maxWidth="Infinity" promptText="Выберите заявителя" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Место *:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbPlot" maxWidth="Infinity" promptText="Выберите место" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Сотрудник:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbEmployee" maxWidth="Infinity" promptText="Назначьте сотрудника" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="ФИО умершего:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="txtDeceasedName" promptText="Иванов Иван Иванович" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Дата рождения:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <DatePicker fx:id="dpBirthDate" maxWidth="Infinity" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Дата смерти:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <DatePicker fx:id="dpDeathDate" maxWidth="Infinity" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <Label text="№ свидетельства:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
        <TextField fx:id="txtCertificate" promptText="серия, номер" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

        <Label text="Статус *:" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbStatus" maxWidth="Infinity" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

        <Label text="Стоимость (₽):" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
        <TextField fx:id="txtCost" promptText="0.00" GridPane.rowIndex="8" GridPane.columnIndex="1"/>

        <Label text="Примечание:" GridPane.rowIndex="9" GridPane.columnIndex="0"/>
        <TextArea fx:id="txtNotes" prefRowCount="3" promptText="Дополнительная информация" GridPane.rowIndex="9" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Сохранить" onAction="#handleSave" defaultButton="true"/>
        <Button text="Отмена" onAction="#handleCancel" cancelButton="true"/>
    </HBox>
</VBox>